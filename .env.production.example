# Copy to .env.production and replace every placeholder before using the
# production Compose template. This file contains no usable credentials.
PUBLIC_IP=34.50.35.119
TLS_CONTACT_EMAIL=replace-with-monitored-address@example.invalid
IP_INGRESS_SUBNET=172.30.251.0/28
IP_INGRESS_PROXY_IP=172.30.251.14
CERTIFICATE_WATCH_INTERVAL_SECONDS=300
LETSENCRYPT_VOLUME_NAME=aisw-production_letsencrypt
LETSENCRYPT_STAGING_VOLUME_NAME=aisw-production_letsencrypt_staging
CERTBOT_WEBROOT_VOLUME_NAME=aisw-production_certbot_webroot
POSTGRES_DB=aisw
POSTGRES_USER=aisw
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://aisw:replace-with-url-encoded-password@db:5432/aisw

APP_ENVIRONMENT=production
SEED_DEMO_DATA=false
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCOUNT_DELETION_RECEIPT_RETENTION_DAYS=replace-with-approved-days
RATE_LIMIT_ENABLED=true
# Set true to let the production helper activate the optional cloudflared
# Compose profile. The Named Tunnel and published routes are created once in
# Cloudflare; this flag starts or stops only this server's connector.
CLOUDFLARE_ENABLED=false
# Prefer an operator-only path outside the checkout. Compose mounts this file
# read-only; the token itself must never be stored in this env file.
CLOUDFLARE_TUNNEL_TOKEN_FILE=../aisw-production-secrets/cloudflare-tunnel-token
# Use a private subnet that does not overlap this host's existing Docker/VPN
# networks. Keep the connector on the high static address and trust only /32.
CLOUDFLARE_TUNNEL_SUBNET=172.30.250.0/28
CLOUDFLARE_TUNNEL_IP=172.30.250.14
# Production refuses to start until proxy trust uses the exact connector IP.
RATE_LIMIT_TRUST_PROXY=true
# Use only the narrow, comma-separated IP/CIDR addresses actually observed as
# the ingress source by the backend. Never use an all-addresses CIDR.
RATE_LIMIT_TRUSTED_PROXY_IPS=172.30.251.14/32
# The public IPv4 is also used as the Host header by the readiness check.
ALLOWED_HOSTS=34.50.35.119
CORS_ORIGIN_REGEX=^https://34\.50\.35\.119$

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=password
SMTP_FROM_EMAIL=replace-with-approved-sender@example.invalid
SMTP_FROM_NAME=서강 AI-SW 대학원 커뮤니티
SMTP_REPLY_TO=replace-with-monitored-address@example.invalid
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_REQUIRED=true

EXPO_PUSH_ENABLED=true
SUPPORT_EMAIL=replace-with-monitored-address@example.invalid
PUBLIC_OPERATOR_NAME=replace-with-approved-legal-operator
PRIVACY_POLICY_EFFECTIVE_DATE=replace-with-yyyy-mm-dd
PRIVACY_POLICY_VERSION=replace-with-approved-version
PUBLIC_API_URL=https://34.50.35.119/api
# Must be longer than SMTP_TIMEOUT_SECONDS; accepted frontend range is 15000-120000 ms.
EXPO_PUBLIC_AUTH_EMAIL_TIMEOUT_MS=120000
SUPPORT_URL=https://34.50.35.119/legal/support
PRIVACY_POLICY_URL=https://34.50.35.119/legal/privacy
ACCOUNT_DELETION_URL=https://34.50.35.119/legal/account-deletion
OPERATIONS_ALERT_WEBHOOK_URL=https://alerts.example.invalid/replace-with-provider-secret
OPERATIONS_ALERT_TIMEOUT_SECONDS=3

MEDIA_UPLOAD_DIR=/data/media
MEDIA_PRIVATE_UPLOAD_DIR=/data/private-media
MEDIA_UPLOAD_MAX_BYTES=20971520
MEDIA_UPLOAD_CHUNK_BYTES=1048576
MEDIA_ACCESS_URL_EXPIRE_SECONDS=300
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif,application/pdf,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/zip,text/plain,application/x-ipynb+json,application/json
MEDIA_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.heic,.heif,.pdf,.doc,.xls,.ppt,.docx,.xlsx,.pptx,.hwp,.zip,.txt,.ipynb

BACKEND_BIND_PORT=8000
FRONTEND_BIND_PORT=8080
# These defaults match the fixed Compose project name. During a rehearsed media
# recovery, point them at newly restored volumes for a reversible cutover.
PRODUCTION_MEDIA_VOLUME_NAME=aisw-production_production_media
PRODUCTION_PRIVATE_MEDIA_VOLUME_NAME=aisw-production_production_private_media

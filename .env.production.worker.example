# Copy to .env.production.worker and replace every placeholder. The worker
# deliberately receives only the settings needed for database-backed push jobs.
# HTTP boundary settings such as ALLOWED_HOSTS, CORS, and proxy trust are
# intentionally omitted because this process does not accept inbound traffic.
APP_ENVIRONMENT=production
SEED_DEMO_DATA=false
DATABASE_URL=postgresql+psycopg://aisw:replace-with-url-encoded-password@db:5432/aisw
ACCOUNT_DELETION_RECEIPT_RETENTION_DAYS=replace-with-approved-days
EXPO_PUSH_ENABLED=true
OPERATIONS_ALERT_WEBHOOK_URL=https://alerts.example.invalid/replace-with-provider-secret
OPERATIONS_ALERT_TIMEOUT_SECONDS=3
NOTIFICATION_JOB_HOUR=9
NOTIFICATION_JOB_MINUTE=0
NOTIFICATION_JOB_RUN_ON_START=false

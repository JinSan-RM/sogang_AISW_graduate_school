FROM node:22.16.0-alpine@sha256:41e4389f3d988d2ed55392df4db1420ad048ae53324a8e2b7c6d19508288107e AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .

ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_AUTH_EMAIL_TIMEOUT_MS
ARG EXPO_PUBLIC_SUPPORT_URL
ARG EXPO_PUBLIC_PRIVACY_POLICY_URL
ARG EXPO_PUBLIC_ACCOUNT_DELETION_URL
ARG EXPO_PUBLIC_SUPPORT_EMAIL
ARG EXPO_PUBLIC_OPERATOR_NAME
ARG EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE
ARG EXPO_PUBLIC_PRIVACY_POLICY_VERSION

ENV NODE_ENV=production \
    EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} \
    EXPO_PUBLIC_AUTH_EMAIL_TIMEOUT_MS=${EXPO_PUBLIC_AUTH_EMAIL_TIMEOUT_MS} \
    EXPO_PUBLIC_SUPPORT_URL=${EXPO_PUBLIC_SUPPORT_URL} \
    EXPO_PUBLIC_PRIVACY_POLICY_URL=${EXPO_PUBLIC_PRIVACY_POLICY_URL} \
    EXPO_PUBLIC_ACCOUNT_DELETION_URL=${EXPO_PUBLIC_ACCOUNT_DELETION_URL} \
    EXPO_PUBLIC_SUPPORT_EMAIL=${EXPO_PUBLIC_SUPPORT_EMAIL} \
    EXPO_PUBLIC_OPERATOR_NAME=${EXPO_PUBLIC_OPERATOR_NAME} \
    EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE=${EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE} \
    EXPO_PUBLIC_PRIVACY_POLICY_VERSION=${EXPO_PUBLIC_PRIVACY_POLICY_VERSION}

RUN npm run export:web

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]

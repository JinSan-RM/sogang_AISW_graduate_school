# Local development may use localhost or Expo's LAN host discovery.
# EAS preview/production must override this with a public HTTPS URL ending in /api.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Upload requests use this timeout instead of the 10-second API default.
# Allowed range: 30000-600000 ms. Invalid values fall back to 120000 ms.
EXPO_PUBLIC_MEDIA_UPLOAD_TIMEOUT_MS=120000
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE=
EXPO_PUBLIC_PRIVACY_POLICY_VERSION=

# EAS production only: create GOOGLE_SERVICES_JSON as a File environment
# variable that points to the approved Firebase Android client config.
